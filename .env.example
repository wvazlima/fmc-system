# ─────────────────────────────────────────────────────────────────────────────
# Ambiente local (Docker Compose) — ADR-0010
# Copie para .env. O .env real NÃO é versionado.
# Nenhum valor real de segredo entra aqui.
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=local
NODE_ENV=development

# ── Portas publicadas no HOST ────────────────────────────────────────────────
# Dentro da rede do Compose os serviços usam sempre a porta padrão. Estas são só as
# portas publicadas no host; ajuste se colidirem com outro projeto seu.
WEB_HOST_PORT=3010
API_HOST_PORT=3011
EDGE_HOST_PORT=8787
DB_HOST_PORT=5442
AUTH_HOST_PORT=9098
STORAGE_HOST_PORT=9000
STORAGE_MASTER_HOST_PORT=9333
SMTP_HOST_PORT=1026
MAIL_UI_HOST_PORT=8026

# ── Portas no HOST ───────────────────────────────────────────────────────────
# Dentro da rede do Compose os serviços sempre usam a porta padrão. Estas são só as
# portas publicadas no host — ajuste se colidirem com outro projeto seu.
WEB_HOST_PORT=3010
API_HOST_PORT=3011
EDGE_HOST_PORT=8787
DB_HOST_PORT=5442
AUTH_HOST_PORT=9098
STORAGE_HOST_PORT=9000
STORAGE_MASTER_HOST_PORT=9333
SMTP_HOST_PORT=1026
MAIL_UI_HOST_PORT=8026

# ── Banco (container `db`: postgis/postgis:16-3.4) ───────────────────────────
POSTGRES_USER=fmc
POSTGRES_PASSWORD=changeme
POSTGRES_DB=fmc
# de dentro dos containers
DATABASE_URL=postgres://fmc:changeme@db:5432/fmc
# do host (psql, drizzle-kit rodando fora do Docker)
DATABASE_URL_HOST=postgres://fmc:changeme@localhost:5442/fmc

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0
LOG_LEVEL=debug

# ── Borda (Cloudflare Worker · local: wrangler dev) — ADR-0006 ───────────────
EDGE_PORT=8787
# a API rejeita com 403 toda requisição sem este cabeçalho
EDGE_SECRET=local-only-not-a-real-secret
# origem da API vista pelo Worker, dentro da rede do Compose
API_ORIGIN=http://api:3001

# ── Web (PWA) ────────────────────────────────────────────────────────────────
WEB_PORT=3000
# vista pelo navegador, no host
NEXT_PUBLIC_API_URL=http://localhost:8787/api  # EDGE_HOST_PORT

# ── Autenticação (Firebase Auth Emulator) — ADR-0012 ─────────────────────────
# projeto com prefixo "demo-" roda sem credencial de nuvem
FIREBASE_PROJECT_ID=demo-fmc
FIREBASE_AUTH_EMULATOR_HOST=auth:9099
# vista pelo navegador, no host
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=localhost:9098  # AUTH_HOST_PORT

# ── Storage (MinIO: stand-in de Cloud Storage e R2) ──────────────────────────
STORAGE_ENDPOINT=http://storage:9000
STORAGE_ACCESS_KEY=fmc-local
STORAGE_SECRET_KEY=changeme-local
STORAGE_BUCKET_MEDIA=fmc-media
STORAGE_BUCKET_MAPS=fmc-maps
STORAGE_REGION=us-east-1

# ── E-mail (Mailpit) ─────────────────────────────────────────────────────────
SMTP_HOST=mail
SMTP_PORT=1025
SMTP_FROM=nao-responda@fmc.local
